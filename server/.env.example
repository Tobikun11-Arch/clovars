# Server
PORT=5000
NODE_ENV=development

# Auth - node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Database (Atlas dev database only — never production)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/clovars_dev?retryWrites=true&w=majority

# Email (dev: Mailtrap/Ethereal or console-log fallback)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Client
CORS_ORIGINS=http://localhost:5173

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate limiting (set to "false" to disable, e.g. during local testing)
RATE_LIMIT_ENABLED=false
